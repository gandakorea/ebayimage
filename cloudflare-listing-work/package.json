{
  "name": "cloudflare-listing-work",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/check-deploy.mjs && npm run build && wrangler deploy",
    "test": "node --test scripts/worker.test.mjs scripts/executor.test.mjs",
    "db:local": "wrangler d1 migrations apply listing-work --local",
    "db:remote": "node scripts/check-deploy.mjs && wrangler d1 migrations apply listing-work --remote"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
